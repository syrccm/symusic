# 태그 자동 생성용 Claude API 키 (서버 전용 — 절대 클라이언트에 노출되지 않음)
# 배포: Vercel 프로젝트 → Settings → Environment Variables 에 동일 키로 등록
# 로컬: 이 파일을 .env 로 복사한 뒤 값 채우기 (vercel dev 실행 시 사용)
ANTHROPIC_API_KEY=

# 다운로드 게시판 파일 저장소(R2 download 버킷 공개 URL, 예: https://download.example.com/). 끝 '/' 유무 무관.
# 클라이언트에 노출되는 값(VITE_ 접두사). 비어 있으면 게시판에 "다운로드 저장소가 설정되지 않았습니다" 안내.
# 배포: Vercel 프로젝트 → Settings → Environment Variables 에 동일 키로 등록 후 재배포(빌드 시 인라인됨)
VITE_DOWNLOAD_BASE_URL=

# ── 설교녹음(관리자 전용, api/rec/*) — 전부 서버 전용. VITE_ 접두사를 붙이지 말 것(붙이면 브라우저 번들에 들어간다) ──
# 배포: Vercel 프로젝트 → Settings → Environment Variables 에 동일 키로 등록 후 재배포
# 녹음 리포(GitHub Actions 가 실제 녹음을 수행)
REC_GH_OWNER=syrccm
REC_GH_REPO=symusic-recorder
REC_GH_WORKFLOW=record.yml
# fine-grained PAT — 대상 리포는 위 녹음 리포 하나만, 권한은 Actions: Read and write + Variables: Read and write
REC_GH_PAT=
# Cloudflare R2 비공개 버킷(녹음 mp3·사이드카 json 이 recordings/ 아래에 올라간다)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sermon-rec
# 녹음을 제어할 수 있는 Firebase UID 허용 목록(쉼표 구분). 비어 있으면 아무도 사용할 수 없다.
REC_ADMIN_UIDS=
