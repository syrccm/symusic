# 태그 자동 생성용 Claude API 키 (서버 전용 — 절대 클라이언트에 노출되지 않음)
# 배포: Vercel 프로젝트 → Settings → Environment Variables 에 동일 키로 등록
# 로컬: 이 파일을 .env 로 복사한 뒤 값 채우기 (vercel dev 실행 시 사용)
ANTHROPIC_API_KEY=

# 다운로드 게시판 파일 저장소(R2 download 버킷 공개 URL, 예: https://download.example.com/). 끝 '/' 유무 무관.
# 클라이언트에 노출되는 값(VITE_ 접두사). 비어 있으면 게시판에 "다운로드 저장소가 설정되지 않았습니다" 안내.
# 배포: Vercel 프로젝트 → Settings → Environment Variables 에 동일 키로 등록 후 재배포(빌드 시 인라인됨)
VITE_DOWNLOAD_BASE_URL=
